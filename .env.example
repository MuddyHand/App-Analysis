# Copiar para .env e preencher. Nunca commitar o .env real.

# --- API oficial da Veo (api.veo.co) ---
# Preencher consoante o tipo de credencial que a Veo disponibilizar.
# Não sabemos ainda qual o esquema de autenticação real (a documentação
# pública é escassa) — o script de teste tenta várias hipóteses comuns.

VEO_API_BASE_URL=https://api.veo.co

# Opção A: token de acesso já emitido (Bearer)
VEO_API_TOKEN=

# Opção B: client credentials (OAuth2 client_credentials grant)
VEO_CLIENT_ID=
VEO_CLIENT_SECRET=

# --- Caminho alternativo: export manual mp4 ---
# Caminho para um ficheiro mp4 exportado manualmente da Veo, para testar
# o pipeline sem depender da API.
MANUAL_EXPORT_MP4_PATH=

# --- Google Sheets (usado nas Fases 3 e 4) ---
# As credenciais do service account já existem no stack de monitorização
# de carga. Serão fornecidas separadamente quando chegarmos à Fase 3.
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=
